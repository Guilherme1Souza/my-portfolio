# Configuração SMTP usada por /api/contact (Nodemailer).
# Copie este arquivo para .env.local e preencha com credenciais reais.
# .env.local NÃO é versionado (está no .gitignore).

# Servidor SMTP. Exemplos:
#   Outlook/Hotmail: smtp-mail.outlook.com (porta 587)
#   Gmail:           smtp.gmail.com        (porta 587)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587

# Credenciais de envio. Para Gmail/Outlook use uma "senha de app"
# (App Password), não a senha normal da conta.
SMTP_USER=seu-email@outlook.com
SMTP_PASS=sua-senha-de-app

# Para onde os contatos serão enviados (sua caixa de entrada).
CONTACT_TO=guilhermeeduardo2016@outlook.com
